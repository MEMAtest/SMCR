# Copy to .env and fill in. Everything is optional: without a database the
# workspace is saved in the browser only; without an API key the AI features
# show a setup notice.

# Postgres (e.g. Neon). Enables "Save to server" + shareable links.
# After setting it, run: npm run db:push   (creates the `workspaces` table)
DATABASE_URL=""

# Claude API for SoR drafting, the handbook assistant and gap review.
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5
# Server-side refusal fallbacks are on by default; set to "off" if your model rejects them
# ANTHROPIC_FALLBACKS=off
